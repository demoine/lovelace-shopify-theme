{{ 'section-social-follow.css' | asset_url | stylesheet_tag }}

<section class="social-follow" id="social-follow-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="social-follow__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="social-follow__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="social-follow__links">
      {%- if settings.social_instagram != blank -%}
        <a href="{{ settings.social_instagram }}" class="social-follow__link" target="_blank" rel="noopener noreferrer" aria-label="{{ 'accessibility.social_instagram' | t }}">
          {% render 'icon-instagram', width: 18, height: 18 %}
          Instagram
        </a>
      {%- endif -%}

      {%- if settings.social_facebook != blank -%}
        <a href="{{ settings.social_facebook }}" class="social-follow__link" target="_blank" rel="noopener noreferrer" aria-label="{{ 'accessibility.social_facebook' | t }}">
          {% render 'icon-facebook', width: 18, height: 18 %}
          Facebook
        </a>
      {%- endif -%}

      {%- if settings.social_tiktok != blank -%}
        <a href="{{ settings.social_tiktok }}" class="social-follow__link" target="_blank" rel="noopener noreferrer" aria-label="{{ 'accessibility.social_tiktok' | t }}">
          {% render 'icon-tiktok', width: 18, height: 18 %}
          TikTok
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social Follow",
  "class": "social-follow-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow LOVELACE'D"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See the latest designs and customer creations."
    }
  ],
  "presets": [
    {
      "name": "Social Follow"
    }
  ]
}
{% endschema %}
