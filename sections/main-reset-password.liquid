<section class="main-login" style="padding: var(--spacing-section) 0;">
  <div class="page-width">
    <div style="max-width: 400px; margin: 0 auto; text-align: center;">
      <h1 style="font-size: clamp(1.5rem, 3.5vw, 2.5rem); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: var(--spacing-lg);">
        {{ 'customer.reset_password.title' | t }}
      </h1>

      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p style="color: green; margin-bottom: var(--spacing-md);">
            We've sent you an email with a link to reset your password.
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <div style="color: var(--color-accent); margin-bottom: var(--spacing-sm);">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="margin-bottom: var(--spacing-sm); text-align: left;">
          <label for="recover-email" class="form-label">{{ 'customer.reset_password.email' | t }}</label>
          <input type="email" name="email" id="recover-email" class="form-input" autocomplete="email" required>
        </div>

        <button type="submit" class="btn btn--primary" style="width: 100%; margin-top: var(--spacing-md);">
          {{ 'customer.reset_password.submit' | t }}
        </button>

        <a href="{{ routes.account_login_url }}" style="display: block; margin-top: var(--spacing-sm); font-size: 0.875rem; color: var(--color-accent); text-decoration: underline;">
          Back to login
        </a>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset Password",
  "class": "main-reset-password-section",
  "settings": []
}
{% endschema %}
