<section class="main-login" style="padding: var(--spacing-section) 0;">
  <div class="page-width page-width--narrow">
    <h1 style="text-align: center; font-size: clamp(1.5rem, 3.5vw, 2.5rem); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: var(--spacing-lg);">
      {{ 'customer.account.addresses' | t }}
    </h1>

    <div style="text-align: center; margin-bottom: var(--spacing-md);">
      <a href="{{ routes.account_url }}" style="font-size: 0.875rem; color: var(--color-accent); text-decoration: underline;">&larr; {{ 'customer.account.title' | t }}</a>
    </div>

    {%- if customer.addresses.size > 0 -%}
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--spacing-md);">
        {%- for address in customer.addresses -%}
          <div style="border: 1px solid var(--color-border); border-radius: var(--border-radius); padding: var(--spacing-md); font-size: 0.875rem; line-height: 1.6;">
            {%- if address == customer.default_address -%}
              <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent); margin-bottom: 0.5rem;">Default</p>
            {%- endif -%}
            {{ address | format_address }}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="text-align: center; opacity: 0.6;">No saved addresses.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer Addresses",
  "class": "main-addresses-section",
  "settings": []
}
{% endschema %}
