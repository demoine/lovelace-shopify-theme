{{ 'section-email-signup.css' | asset_url | stylesheet_tag }}

<section class="email-signup" id="email-signup-{{ section.id }}">
  <div class="page-width">
    <div class="email-signup__content">
      {%- if section.settings.show_logo -%}
        <div class="email-signup__logo">
          {% render 'lovelace-logo', width: 48, height: 48 %}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="email-signup__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subline != blank -%}
        <p class="email-signup__subline">{{ section.settings.subline }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'newsletter-form', data-newsletter-form: '' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="email-signup__form">
          <input
            type="email"
            name="contact[email]"
            class="email-signup__input"
            placeholder="{{ 'newsletter.email_placeholder' | t }}"
            required
            autocomplete="email"
            aria-label="{{ 'newsletter.email_placeholder' | t }}"
          >
          <button type="submit" class="email-signup__submit">
            {{ 'newsletter.submit' | t }}
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="email-signup__status" role="status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="email-signup__status" role="alert">{{ 'newsletter.error' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email Signup",
  "class": "email-signup-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get on the list"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline",
      "default": "New drops. Early access. No noise."
    }
  ],
  "presets": [
    {
      "name": "Email Signup"
    }
  ]
}
{% endschema %}
