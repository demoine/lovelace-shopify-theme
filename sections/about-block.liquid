{{ 'section-about-block.css' | asset_url | stylesheet_tag }}

<section class="about-block{% if section.settings.alternate_background %} about-block--alt{% endif %}" id="about-{{ section.id }}">
  <div class="page-width">
    <div class="about-block__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="about-block__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="about-block__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.image != blank -%}
        <div class="about-block__image">
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.image.alt | escape }}"
            width="900"
            height="{{ 900 | divided_by: section.settings.image.aspect_ratio | round }}"
            loading="lazy"
          >
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Block",
  "class": "about-block-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Section body text goes here.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)"
    },
    {
      "type": "checkbox",
      "id": "alternate_background",
      "label": "Use alternate background",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "About Block"
    }
  ]
}
{% endschema %}
