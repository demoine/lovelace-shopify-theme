{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="site-footer" role="contentinfo">
  <div class="page-width site-footer__inner">
    {%- comment -%} Logo {%- endcomment -%}
    <div class="site-footer__logo">
      {% render 'lovelace-logo', width: 48, height: 48 %}
    </div>

    {%- comment -%} Social Links {%- endcomment -%}
    {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank -%}
      <div class="site-footer__social">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" class="site-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="{{ 'accessibility.social_instagram' | t }}">
            {% render 'icon-instagram', width: 18, height: 18 %}
          </a>
        {%- endif -%}
        {%- if settings.social_facebook != blank -%}
          <a href="{{ settings.social_facebook }}" class="site-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="{{ 'accessibility.social_facebook' | t }}">
            {% render 'icon-facebook', width: 18, height: 18 %}
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" class="site-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="{{ 'accessibility.social_tiktok' | t }}">
            {% render 'icon-tiktok', width: 18, height: 18 %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Policy Links {%- endcomment -%}
    <nav class="site-footer__policies" aria-label="Footer policies">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          <a href="{{ policy.url }}" class="site-footer__policy-link">{{ policy.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} Copyright {%- endcomment -%}
    <p class="site-footer__copyright">{{ settings.copyright_text }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "site-footer-section",
  "settings": []
}
{% endschema %}
