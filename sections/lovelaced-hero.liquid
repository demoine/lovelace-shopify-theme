{{ 'section-hero.css' | asset_url | stylesheet_tag }}

<section
  class="hero hero--dark{% if section.settings.image != blank %} hero--with-image{% endif %}"
  {% if section.settings.image != blank %}
    style="background-image: url('{{ section.settings.image | image_url: width: 1920 }}')"
  {% endif %}
  id="lovelaced-hero-{{ section.id }}"
>
  {%- if section.settings.image != blank -%}
    <div class="hero__overlay"></div>
  {%- endif -%}

  <div class="hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheadline != blank -%}
      <div class="hero__body">{{ section.settings.subheadline }}</div>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="hero__cta">
        <a
          href="{{ section.settings.cta_link | default: '#product-customizer' }}"
          class="btn btn--primary"
        >
          {{ section.settings.cta_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LOVELACE'D Hero",
  "class": "lovelaced-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make it yours."
    },
    {
      "type": "richtext",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "<p>Custom photo luggage tags, designed by you, printed by us. Double-sided. Durable. Personal.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Start Designing"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (optional)"
    }
  ],
  "presets": [
    {
      "name": "LOVELACE'D Hero"
    }
  ]
}
{% endschema %}
