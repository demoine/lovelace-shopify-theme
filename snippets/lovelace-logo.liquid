{%- comment -%}
  LOVELACE logo.
  Displays the uploaded logo image, or falls back to the brand name as text.
  Usage: {% render 'lovelace-logo', width: 120, class: '' %}
{%- endcomment -%}

{%- assign logo_width = width | default: 120 -%}
{%- assign logo_class = class | default: '' -%}

{%- if settings.logo != blank -%}
  <img
    src="{{ settings.logo | image_url: width: logo_width }}"
    alt="{{ settings.brand_name }}"
    width="{{ logo_width }}"
    height="{{ logo_width | divided_by: settings.logo.aspect_ratio | round }}"
    class="lovelace-logo {{ logo_class }}"
    loading="eager"
  >
{%- else -%}
  <span class="lovelace-logo-text {{ logo_class }}">{{ settings.brand_name }}</span>
{%- endif -%}
